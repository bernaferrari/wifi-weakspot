{
  "app": "WiFi Weakspot",
  "locales": [
    "en-US",
    "de-DE",
    "es-ES",
    "pt-BR",
    "fr-FR",
    "it-IT",
    "ru-RU",
    "ja-JP",
    "ko-KR",
    "zh-CN"
  ],
  "defaultLocale": "en-US",
  "writeAssets": false,
  "contactSheets": {
    "phone": "gallery-contact-sheet.jpg",
    "tablet7": "gallery-tablet7.jpg",
    "tablet10": "gallery-tablet10.jpg",
    "desktop": "gallery-desktop.jpg"
  },
  "supersample": 2,
  "minFit": 0.62,
  "capture": {
    "build": "./gradlew :androidApp:assembleScreenshots -q",
    "install": [
      {
        "apk": "androidApp/build/outputs/apk/screenshots/androidApp-screenshots.apk",
        "package": "com.bernaferrari.wifiweakspot.screenshots"
      }
    ],
    "runs": [
      {
        "script": "scripts/capture_android_screenshots.py",
        "args": [
          "--store-only",
          "--theme",
          "light"
        ]
      },
      {
        "script": "scripts/capture_history_example.py",
        "args": [
          "--theme",
          "light"
        ]
      },
      {
        "script": "scripts/capture_android_screenshots.py",
        "args": [
          "--settings-only",
          "--theme",
          "dark"
        ],
        "profiles": [
          "phone"
        ],
        "locales": "default"
      }
    ],
    "after": [
      "uv run -q --with pillow python3 store-listing/prepare.py",
      "python3 scripts/refresh_readme_assets.py"
    ]
  },
  "identity": {
    "icon": "../docs/app-icon.png"
  },
  "frames": {
    "phone": {
      "bezel": 0.02,
      "radius": 0.09
    },
    "tablet": {
      "bezel": 0.02,
      "radius": 0.09
    },
    "landscape": {
      "bezel": 0.011,
      "radius": 0.035
    },
    "browser": {
      "bezel": 0.011,
      "radius": 0.035
    }
  },
  "bounds": {
    "layouts": {
      "wide": {
        "cut": true
      }
    }
  }
}
